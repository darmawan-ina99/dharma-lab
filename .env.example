# ============================================
# Dharma Lab - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit the .env file!

# ===== Supabase Configuration =====
# Get these from your Supabase dashboard:
# https://supabase.com/dashboard/project/{your-project-ref}/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Anon/Publishable key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Service role key (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Secret API key
SUPABASE_SECRET_KEY="sb_secret_xxx"

# Database password (used to construct connection strings)
SUPABASE_DB_PASSWORD="your-database-password"

# ===== Prisma Database Connection =====
# Format: postgresql://postgres.{ref}:{password}@{pooler-host}:{port}/postgres?pgbouncer=true&connection_limit=1
# Note: URL-encode special chars in password (e.g., ! -> %21)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (for migrations, no pooler)
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# ===== Admin Configuration =====
# Admin password for the dashboard login
# Default is 900021 (defined in src/lib/auth.ts)
# Change this in src/lib/auth.ts for production use

# ===== Google Analytics (Optional) =====
# Replace G-XXXXXXXXXX in src/app/layout.tsx with your GA4 measurement ID
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
